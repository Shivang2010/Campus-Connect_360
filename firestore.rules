rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Lost & Found
    match /lost_found/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.reportedBy == request.auth.uid;
      allow update, delete: if isAuthenticated() && 
        (resource.data.reportedBy == request.auth.uid || isAdmin());
    }

    // 3. Marketplace
    match /marketplace/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && 
        (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    // 4. Events (Announcements) - Read by all students, managed by Admin
    match /events/{docId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // 5. Notes & Study Materials
    match /notes/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.uploadedBy == request.auth.uid;
      allow update, delete: if isAuthenticated() && 
        (resource.data.uploadedBy == request.auth.uid || isAdmin());
    }

    // 6. Complaints & Grievance Tracker
    match /complaints/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.reportedBy == request.auth.uid;
      allow update: if isAdmin() || (isAuthenticated() && resource.data.reportedBy == request.auth.uid);
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.reportedBy == request.auth.uid);
    }

    // 7. Real-Time 1-to-1 Chats & Private Messages
    match /chats/{chatId} {
      // Only participants can read or list their conversations
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;

      // A chat can only be created if the current user is one of the participants
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;

      // Participants can update metadata (lastMessage, lastMessageTime, updatedAt)
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants;

      // Messages subcollection: chats/{chatId}/messages/{messageId}
      match /messages/{messageId} {
        function isChatParticipant() {
          return isAuthenticated() && 
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        }

        // Only participants can read messages
        allow read: if isChatParticipant();

        // Only participants can send, and senderId must match authenticated UID
        allow create: if isChatParticipant() && request.resource.data.senderId == request.auth.uid;

        // Only the receiver can update message status (e.g. marking isRead = true)
        allow update: if isChatParticipant() && resource.data.receiverId == request.auth.uid;
      }
    }
  }
}
